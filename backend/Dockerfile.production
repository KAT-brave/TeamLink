# 本番用マルチステージ Dockerfile。
# 開発用の Dockerfile.dev とは別ファイルとして管理する。
# 秘密情報(master.key / .env)はイメージへ埋め込まず、実行時に環境変数で渡す。

# ---- ビルドステージ: gem をコンパイルしてインストールする ----
FROM ruby:3.3.2-slim AS builder

ENV RAILS_ENV=production \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_WITHOUT=development:test \
    BUNDLE_PATH=/usr/local/bundle

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends build-essential libpq-dev git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Gemfile Gemfile.lock ./
RUN gem install bundler && \
    bundle install && \
    rm -rf "${BUNDLE_PATH}"/ruby/*/cache

COPY . .

# bootsnap プリコンパイルで起動を高速化する。
RUN bundle exec bootsnap precompile app/ lib/ || true

# ---- 実行ステージ: 実行に必要な最小限だけを含める ----
FROM ruby:3.3.2-slim AS runtime

ENV RAILS_ENV=production \
    BUNDLE_DEPLOYMENT=1 \
    BUNDLE_WITHOUT=development:test \
    BUNDLE_PATH=/usr/local/bundle \
    RAILS_LOG_TO_STDOUT=1 \
    PORT=3000

# libpq(PostgreSQL クライアント)と、ヘルスチェック用の curl のみ。
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends libpq5 curl && \
    rm -rf /var/lib/apt/lists/*

# 非 root ユーザーで実行する。
RUN groupadd --system --gid 1000 rails && \
    useradd --system --uid 1000 --gid rails --create-home rails

WORKDIR /app

COPY --from=builder --chown=rails:rails /usr/local/bundle /usr/local/bundle
COPY --from=builder --chown=rails:rails /app /app

# 実行時に生成されるディレクトリの権限を確保する。
RUN mkdir -p tmp log storage && chown -R rails:rails tmp log storage

USER rails

EXPOSE 3000

# エントリポイントで(任意で)マイグレーションを実行してからサーバを起動する。
# ポートは puma.rb が ENV["PORT"](既定 3000)を参照するため -p は指定しない。
# これにより Render が割り当てる PORT でも待ち受けられる。
ENTRYPOINT ["bin/docker-entrypoint.production"]
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
