# 本番用 Nginx 設定テンプレート。
# 起動時に docker-entrypoint.sh が envsubst で以下を差し込む:
#   ${PORT}           … リッスンするポート(Render は PORT を割り当てる。既定 80)
#   ${BACKEND_HOST}   … バックエンドのホスト名(Compose: backend / Render: 内部ホスト)
#   ${BACKEND_PORT}   … バックエンドのポート(Compose: 3000 / Render: バックエンドのPORT)
#   ${NGINX_RESOLVER} … DNS リゾルバ(/etc/resolv.conf から取得。Docker/Render 両対応)
# nginx のランタイム変数($host 等)は envsubst の対象に含めないため保持される。

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # サービス名をリクエスト時に解決するためのリゾルバ(起動時失敗を避ける)。
    resolver ${NGINX_RESOLVER} valid=10s;

    # 静的アセットは長期キャッシュ(ハッシュ付きファイル名のため安全)。
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # API はバックエンドへプロキシ(ホスト/ポートは環境変数由来)。
    location /api/ {
        set $backend_upstream ${BACKEND_HOST};
        proxy_pass http://$backend_upstream:${BACKEND_PORT}$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Action Cable(WebSocket)はアップグレードヘッダ付きでプロキシ。
    location /cable {
        set $backend_upstream ${BACKEND_HOST};
        proxy_pass http://$backend_upstream:${BACKEND_PORT}$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # SPA フォールバック: 直接アクセスやリロードでも 404 にしない。
    location / {
        try_files $uri $uri/ /index.html;
    }
}
