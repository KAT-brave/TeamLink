# 本番用マルチステージ Dockerfile。
# 開発用の Dockerfile.dev とは別ファイルとして管理する。
# Node で production build し、生成した静的ファイルを Nginx で配信する。

# ---- ビルドステージ: 静的アセットを生成する ----
FROM node:22-slim AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

# Action Cable は Nginx 経由で同一オリジンの /cable へ接続する。
# API クライアントは相対パス /api を使うため VITE_API_BASE_URL は不要。
ENV VITE_CABLE_URL=/cable
RUN npm run build

# ---- 実行ステージ: Nginx で静的配信 + API/Cable プロキシ ----
FROM nginx:1.27-alpine AS runtime

# 既定の設定を置き換える。
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
