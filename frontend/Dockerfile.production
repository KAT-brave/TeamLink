# 本番用マルチステージ Dockerfile。
# 開発用の Dockerfile.dev とは別ファイルとして管理する。
# Node で production build し、生成した静的ファイルを Nginx で配信する。

# ---- ビルドステージ: 静的アセットを生成する ----
FROM node:22-slim AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

# Action Cable の接続先。既定は Nginx 経由の同一オリジン /cable。
# ビルド時に build arg で上書き可能(Vite は import.meta.env をビルド時に展開するため)。
# API クライアントは相対パス /api を使うため VITE_API_BASE_URL は不要。
ARG VITE_CABLE_URL=/cable
ENV VITE_CABLE_URL=${VITE_CABLE_URL}
RUN npm run build

# ---- 実行ステージ: Nginx で静的配信 + API/Cable プロキシ ----
FROM nginx:1.27-alpine AS runtime

# 既定の設定を削除し、テンプレートと独自エントリポイントを配置する。
# 設定は起動時に環境変数(PORT / BACKEND_HOST / BACKEND_PORT)から生成する。
# nginx 公式イメージの ENTRYPOINT(/docker-entrypoint.sh)を上書きし、
# 既定の envsubst(全変数置換で nginx 変数を壊す)を回避する。
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf.template /etc/nginx/nginx.conf.template
COPY docker-entrypoint.sh /docker-entrypoint.sh
COPY --from=builder /app/dist /usr/share/nginx/html
RUN chmod +x /docker-entrypoint.sh

# 既定値(ローカル production Compose 用)。Render では PORT 等が上書きされる。
ENV PORT=80 \
    BACKEND_HOST=backend \
    BACKEND_PORT=3000

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
