# 本番相当の環境変数サンプル。
# 実値は書かず、コピーして .env.production を作成する(.env.production は Git 管理外)。
#   cp .env.production.example .env.production
# 使い方:
#   docker compose -f docker-compose.production.yml --env-file .env.production up --build

# ---- Rails ----
RAILS_ENV=production
# config/credentials.yml.enc を復号する master key。実値は config/master.key の中身。
# イメージへは埋め込まず、実行時に環境変数として渡す。
# ローカル本番 Compose では設定する。Render では Dashboard から手動入力する。
RAILS_MASTER_KEY=your_rails_master_key_here
# Cookie 署名等に使う秘密鍵。ローカルでは credentials 由来のため未設定でよい。
# Render では自動生成(generateValue)される。実値は Git に置かない。
# SECRET_KEY_BASE=render_generates_this

# ---- PostgreSQL ----
POSTGRES_USER=teamlink
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=teamlink_production
# Rails からの接続文字列。ホスト名は Compose のサービス名 "db"。
DATABASE_URL=postgres://teamlink:change_me_strong_password@db:5432/teamlink_production

# ---- Redis(Action Cable 用) ----
# ホスト名は Compose のサービス名 "redis"。
REDIS_URL=redis://redis:6379/1

# ---- CORS / Cookie ----
# フロントを配信するオリジン。CORS 許可オリジンとして使用する。
# フロントと API を同一オリジンで配信する場合でも設定しておく。
FRONTEND_ORIGIN=https://your-domain.example.com

# ---- ポート / Nginx プロキシ先 ----
# Rails がリッスンするポート(Render では PORT が自動割り当てされる)。
PORT=3000
# フロント(Nginx)を公開するホスト側ポート(既定 8080)。ホストで衝突する場合に変更する。
FRONTEND_PORT=8080
# フロント(Nginx)が /api・/cable をプロキシする先。
# ローカル Compose ではサービス名 backend:3000。Render では backend の内部ホスト/ポート。
BACKEND_HOST=backend
BACKEND_PORT=3000

# ---- フロントエンド(ビルド時に静的バンドルへ焼き込まれる。実行時 env では変更不可) ----
# API クライアントは相対パス /api を使うため VITE_API_BASE_URL は現状のコードでは未使用。
# フロントと API を別オリジンで配信する場合は、Nginx プロキシをやめて下記を設定する運用も可能。
# VITE_API_BASE_URL=https://your-domain.example.com
# Action Cable の接続先。Nginx 経由の同一オリジン配信では /cable(相対)を使用する。
# この値は docker-compose.production.yml の frontend.build.args 経由でビルド時に反映される。
VITE_CABLE_URL=/cable

# ---- 注意: 本番の Cookie / HTTPS 前提 ----
# 本番(RAILS_ENV=production)では以下が有効:
#   - config.force_ssl = true / config.assume_ssl = true(HTTPS 前提。逆プロキシで TLS 終端する想定)
#   - セッション Cookie は secure=true, httponly=true, same_site=:lax
# フロントと API を別ドメインにするとクロスサイトになり SameSite=Lax の Cookie が送られないため、
# 本サンプルでは Nginx が /api・/cable を同一オリジンでプロキシする構成を採用している。
